<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <CheckBoxPreference
        android:defaultValue="true"
        android:key="chatNotify"
        android:summary="@string/chatNotificationsSum"
        android:title="@string/chatNotifications"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:key="stay_awake"
        android:defaultValue="false"
        android:title="@string/stay_awake"
        android:summary="@string/stay_awake_sum"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="useTts"
        android:summary="@string/useTtsSum"
        android:title="@string/useTts"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="shortTtsMessages"
        android:summary="@string/shortTtsMessagesSum"
        android:title="@string/shortTtsMessages"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="load_images"
        android:summary="@string/loadImagesSum"
        android:title="@string/loadImages"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="autoReconnect"
        android:summary="@string/autoReconnectSum"
        android:title="@string/autoReconnect"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="forceTcp"
        android:summary="@string/forceTcpSum"
        android:title="@string/forceTcp"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="useTor"
        android:summary="@string/useTorSum"
        android:title="@string/useTor"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:defaultValue="false"
        android:key="startUpInPinnedMode"
        android:summary="@string/pref_start_upIn_pinned_mode_sum"
        android:title="@string/pref_start_up_in_pinned_mode"
        app:iconSpaceReserved="false" />

    <PreferenceCategory
        android:title="@string/pref_gps_tracking_category"
        app:iconSpaceReserved="false">

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="gpsTrackingEnabled"
            android:summary="@string/pref_gps_tracking_enabled_sum"
            android:title="@string/pref_gps_tracking_enabled"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:defaultValue=""
            android:key="traccarUrl"
            android:title="@string/pref_traccar_url"
            android:summary="@string/pref_traccar_url_sum"
            android:dialogTitle="@string/pref_traccar_url"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:defaultValue=""
            android:key="traccarDeviceId"
            android:title="@string/pref_traccar_device_id"
            android:summary="@string/pref_traccar_device_id_sum"
            android:dialogTitle="@string/pref_traccar_device_id"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:defaultValue="60"
            android:key="gpsUpdateInterval"
            android:title="@string/pref_gps_update_interval"
            android:summary="@string/pref_gps_update_interval_sum"
            android:dialogTitle="@string/pref_gps_update_interval"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:defaultValue="10"
            android:key="gpsMinDistance"
            android:title="@string/pref_gps_min_distance"
            android:summary="@string/pref_gps_min_distance_sum"
            android:dialogTitle="@string/pref_gps_min_distance"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>
</PreferenceScreen>
